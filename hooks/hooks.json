{
  "description": "Observe task lifecycle locally. Does not approve, block, or continue tasks.",
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python \"${PLUGIN_ROOT}/runtime.py\" hook", "command_windows": "python \"$env:PLUGIN_ROOT/runtime.py\" hook", "timeout": 8}]}],
    "PreToolUse": [{"hooks": [{"type": "command", "command": "python \"${PLUGIN_ROOT}/runtime.py\" hook", "command_windows": "python \"$env:PLUGIN_ROOT/runtime.py\" hook", "timeout": 3}]}],
    "PermissionRequest": [{"hooks": [{"type": "command", "command": "python \"${PLUGIN_ROOT}/runtime.py\" hook", "command_windows": "python \"$env:PLUGIN_ROOT/runtime.py\" hook", "timeout": 3}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "python \"${PLUGIN_ROOT}/runtime.py\" hook", "command_windows": "python \"$env:PLUGIN_ROOT/runtime.py\" hook", "timeout": 3}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python \"${PLUGIN_ROOT}/runtime.py\" hook", "command_windows": "python \"$env:PLUGIN_ROOT/runtime.py\" hook", "timeout": 3}]}],
    "Interrupt": [{"hooks": [{"type": "command", "command": "python \"${PLUGIN_ROOT}/runtime.py\" hook", "command_windows": "python \"$env:PLUGIN_ROOT/runtime.py\" hook", "timeout": 3}]}]
  }
}
